{
  "name": "@clipcourse/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Clipcourse editor: build courses on a timeline",
  "author": "Philippe",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @clipcourse/scorm-runtime build && vite",
    "build": "pnpm --filter @clipcourse/scorm-runtime build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:lms": "pnpm --filter @clipcourse/scorm-runtime build && playwright test -c playwright.lms.config.ts"
  },
  "dependencies": {
    "@clipcourse/editor-core": "workspace:*",
    "@clipcourse/exporter": "workspace:*",
    "@clipcourse/format": "workspace:*",
    "@clipcourse/player": "workspace:*",
    "@clipcourse/scorm-runtime": "workspace:*",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@clipcourse/mcp-server": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3"
  }
}
