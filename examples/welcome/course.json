{
  "formatVersion": 2,
  "id": "welcome_to_clipcourse",
  "title": "Welcome to Clipcourse",
  "language": "en",
  "stage": {
    "width": 1920,
    "height": 1080,
    "background": "#0f1320"
  },
  "assets": {
    "logo": {
      "kind": "image",
      "src": "assets/logo.svg",
      "mime": "image/svg+xml",
      "alt": "Clipcourse logo"
    },
    "timeline": {
      "kind": "image",
      "src": "assets/timeline.svg",
      "mime": "image/svg+xml",
      "alt": "A timeline with three tracks: text, images and audio, and a red playhead"
    },
    "testpattern": {
      "kind": "video",
      "src": "assets/testpattern.mp4",
      "mime": "video/mp4",
      "duration": 8000
    },
    "testpattern_cc": {
      "kind": "captions",
      "src": "assets/testpattern.vtt",
      "mime": "text/vtt"
    },
    "chord": {
      "kind": "audio",
      "src": "assets/chord.m4a",
      "mime": "audio/mp4",
      "duration": 6000
    },
    "chord_cc": {
      "kind": "captions",
      "src": "assets/chord.vtt",
      "mime": "text/vtt"
    }
  },
  "courseLayer": {
    "background": [],
    "foreground": [
      {
        "id": "brand",
        "name": "Branding",
        "clips": [
          {
            "id": "brand_logo",
            "type": "image",
            "assetId": "logo",
            "alt": "",
            "start": 0,
            "duration": 3600000,
            "frame": {
              "x": 1800,
              "y": 40,
              "width": 80,
              "height": 80
            },
            "opacity": 0.8
          }
        ]
      },
      {
        "id": "progress",
        "name": "Progress",
        "clips": [
          {
            "id": "course_progress",
            "type": "progress",
            "fill": "#4f8cff",
            "background": "rgba(255,255,255,0.15)",
            "radius": 0,
            "start": 0,
            "duration": 86400000,
            "frame": {
              "x": 0,
              "y": 1068,
              "width": 1920,
              "height": 12
            }
          }
        ]
      }
    ]
  },
  "chapters": [
    {
      "id": "welcome",
      "title": "Welcome",
      "duration": 6000,
      "transition": {
        "mode": "wait"
      },
      "tracks": [
        {
          "id": "welcome_bg",
          "name": "Background",
          "clips": [
            {
              "id": "welcome_panel",
              "type": "shape",
              "shape": "rect",
              "fill": "#1d2230",
              "radius": 32,
              "start": 0,
              "duration": 6000,
              "frame": {
                "x": 160,
                "y": 140,
                "width": 1600,
                "height": 800
              }
            }
          ]
        },
        {
          "id": "welcome_text",
          "name": "Text",
          "clips": [
            {
              "id": "welcome_title",
              "type": "text",
              "role": "heading",
              "text": "Welcome to Clipcourse",
              "style": {
                "fontSize": 110,
                "fontWeight": 700,
                "color": "#ffffff",
                "align": "center"
              },
              "start": 0,
              "duration": 6000,
              "frame": {
                "x": 160,
                "y": 300,
                "width": 1600,
                "height": 160
              },
              "animations": {
                "in": {
                  "type": "zoom",
                  "duration": 800,
                  "easing": "ease-out"
                }
              }
            }
          ]
        },
        {
          "id": "welcome_subtitle",
          "name": "Subtitle",
          "clips": [
            {
              "id": "welcome_sub",
              "type": "text",
              "text": "Courses built like videos – on a timeline.",
              "style": {
                "fontSize": 56,
                "color": "#a1a7b3",
                "align": "center"
              },
              "start": 1500,
              "duration": 4500,
              "frame": {
                "x": 160,
                "y": 480,
                "width": 1600,
                "height": 100
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 600,
                  "easing": "ease-out"
                }
              }
            }
          ]
        },
        {
          "id": "welcome_hints",
          "name": "Hint",
          "clips": [
            {
              "id": "welcome_hint",
              "type": "box",
              "text": "Press Continue when you are ready.",
              "fill": "#4f8cff",
              "radius": 20,
              "padding": 24,
              "style": {
                "fontSize": 40,
                "color": "#ffffff",
                "align": "center",
                "verticalAlign": "middle"
              },
              "start": 3500,
              "duration": 2500,
              "frame": {
                "x": 560,
                "y": 680,
                "width": 800,
                "height": 110
              },
              "animations": {
                "in": {
                  "type": "slide",
                  "direction": "down",
                  "duration": 600,
                  "easing": "ease-out"
                }
              }
            }
          ]
        },
        {
          "id": "welcome_arrows",
          "name": "Highlights",
          "clips": [
            {
              "id": "welcome_arrow",
              "type": "shape",
              "shape": "arrow",
              "stroke": "#ffd166",
              "strokeWidth": 10,
              "start": 3500,
              "duration": 2500,
              "frame": {
                "x": 1400,
                "y": 715,
                "width": 300,
                "height": 40,
                "rotation": 30
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 400,
                  "easing": "ease-out"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "timeline",
      "title": "The timeline is the beat",
      "duration": 9000,
      "transition": {
        "mode": "auto"
      },
      "tracks": [
        {
          "id": "timeline_images",
          "name": "Images",
          "clips": [
            {
              "id": "timeline_diagram",
              "type": "image",
              "assetId": "timeline",
              "fit": "contain",
              "start": 0,
              "duration": 9000,
              "frame": {
                "x": 160,
                "y": 420,
                "width": 1600,
                "height": 600
              }
            }
          ]
        },
        {
          "id": "timeline_text",
          "name": "Text",
          "clips": [
            {
              "id": "timeline_t1",
              "type": "text",
              "role": "heading",
              "text": "Every chapter has its own timeline.",
              "style": {
                "fontSize": 72,
                "fontWeight": 700,
                "color": "#ffffff"
              },
              "start": 0,
              "duration": 3000,
              "frame": {
                "x": 160,
                "y": 140,
                "width": 1600,
                "height": 120
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 400,
                  "easing": "ease-out"
                },
                "out": {
                  "type": "fade",
                  "duration": 300,
                  "easing": "ease-in"
                }
              }
            },
            {
              "id": "timeline_t2",
              "type": "text",
              "role": "heading",
              "text": "Clips start and end at exact times.",
              "style": {
                "fontSize": 72,
                "fontWeight": 700,
                "color": "#ffffff"
              },
              "start": 3000,
              "duration": 3000,
              "frame": {
                "x": 160,
                "y": 140,
                "width": 1600,
                "height": 120
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 400,
                  "easing": "ease-out"
                },
                "out": {
                  "type": "fade",
                  "duration": 300,
                  "easing": "ease-in"
                }
              }
            },
            {
              "id": "timeline_t3",
              "type": "text",
              "role": "heading",
              "text": "This chapter continues automatically.",
              "style": {
                "fontSize": 72,
                "fontWeight": 700,
                "color": "#06d6a0"
              },
              "start": 6000,
              "duration": 3000,
              "frame": {
                "x": 160,
                "y": 140,
                "width": 1600,
                "height": 120
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 400,
                  "easing": "ease-out"
                },
                "out": {
                  "type": "fade",
                  "duration": 300,
                  "easing": "ease-in"
                }
              }
            }
          ]
        },
        {
          "id": "timeline_marks",
          "name": "Highlights",
          "clips": [
            {
              "id": "timeline_ring",
              "type": "highlight",
              "kind": "frame",
              "color": "#ff5d73",
              "strokeWidth": 8,
              "radius": 60,
              "pulse": true,
              "label": "The playhead marks the current time",
              "start": 3000,
              "duration": 3000,
              "frame": {
                "x": 1060,
                "y": 420,
                "width": 180,
                "height": 120
              },
              "animations": {
                "in": {
                  "type": "fade",
                  "duration": 300,
                  "easing": "ease-out"
                }
              }
            }
          ]
        }
      ],
      "markers": [
        {
          "id": "marker_clips",
          "time": 3000,
          "title": "Exact timing"
        },
        {
          "id": "marker_auto",
          "time": 6000,
          "title": "Automatic transitions"
        }
      ]
    },
    {
      "id": "media",
      "title": "Video, audio and captions",
      "duration": 10000,
      "transition": {
        "mode": "wait"
      },
      "tracks": [
        {
          "id": "media_video",
          "name": "Video",
          "clips": [
            {
              "id": "media_clip",
              "type": "video",
              "assetId": "testpattern",
              "captionsAssetId": "testpattern_cc",
              "fit": "contain",
              "start": 0,
              "duration": 8000,
              "frame": {
                "x": 160,
                "y": 260,
                "width": 1100,
                "height": 619
              }
            }
          ]
        },
        {
          "id": "media_text",
          "name": "Text",
          "clips": [
            {
              "id": "media_title",
              "type": "text",
              "role": "heading",
              "text": "Video and audio follow the timeline.",
              "style": {
                "fontSize": 64,
                "fontWeight": 700,
                "color": "#ffffff"
              },
              "start": 0,
              "duration": 10000,
              "frame": {
                "x": 160,
                "y": 100,
                "width": 1600,
                "height": 120
              }
            }
          ]
        },
        {
          "id": "media_notes",
          "name": "Note",
          "clips": [
            {
              "id": "media_note",
              "type": "box",
              "text": "Turn on captions with the CC button or the C key.",
              "fill": "#1d2230",
              "stroke": "#4f8cff",
              "strokeWidth": 4,
              "radius": 16,
              "padding": 28,
              "style": {
                "fontSize": 40,
                "color": "#ffffff",
                "verticalAlign": "middle"
              },
              "start": 1000,
              "duration": 9000,
              "frame": {
                "x": 1320,
                "y": 260,
                "width": 440,
                "height": 300
              },
              "animations": {
                "in": {
                  "type": "slide",
                  "direction": "right",
                  "duration": 700,
                  "easing": "ease-out"
                }
              }
            }
          ]
        },
        {
          "id": "media_audio",
          "name": "Audio",
          "clips": [
            {
              "id": "media_sound",
              "type": "audio",
              "assetId": "chord",
              "captionsAssetId": "chord_cc",
              "volume": 0.5,
              "start": 8500,
              "duration": 1500
            }
          ]
        }
      ],
      "markers": [
        {
          "id": "marker_audio",
          "time": 8500,
          "title": "Audio clip"
        }
      ]
    }
  ]
}
